# ==============================================================================
# IncuBrix Script, Voiceover & B-roll Video Engine - Environment Configuration
# ==============================================================================

# Server Environment
APP_ENV=development
APP_DEBUG=true
APP_HOST=0.0.0.0
APP_PORT=8000
APP_WORKERS=1
LOG_LEVEL=INFO

# Security & Webhook Signatures
WEBHOOK_SECRET=test-webhook-hmac-secret-key-32chars

# Database / Job Persistence
# SQLite for lightweight local dev; supports PostgreSQL (e.g. postgresql+asyncpg://user:pass@localhost:5432/broll)
DATABASE_URL=sqlite+aiosqlite:///data/jobs.db

# S3 / MinIO Storage Configuration
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=broll-engine-bucket
S3_REGION=us-east-1
S3_SECURE=false

# Speech Processing: ASR (Speech-to-Text)
# Options: 'mock' (for fast zero-download tests), 'faster-whisper' (production)
ASR_PROVIDER=mock
WHISPER_MODEL_SIZE=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# Speech Processing: TTS (Text-to-Speech)
# Options: 'mock' (for fast zero-download tests), 'edge-tts' (production)
TTS_PROVIDER=mock
DEFAULT_VOICE_EN_IN=en-IN-NeerjaNeural
DEFAULT_VOICE_HI_IN=hi-IN-SwaraNeural
DEFAULT_VOICE_TA_IN=ta-IN-PallaviNeural
DEFAULT_VOICE_EN_US=en-US-JennyNeural

# Voice Activity Detection for audio preflight
# Options: 'silero' (ML-based, uses faster-whisper VAD), 'energy' (lightweight RMS analysis)
VAD_PROVIDER=silero

# Footage Retrieval
# RETRIEVAL_PROVIDER_MODE: 'live' queries configured stock APIs; 'mock' uses procedural fallback only
RETRIEVAL_PROVIDER_MODE=live
FOOTAGE_CACHE_DIR=data/cache/footage
# Minimum normalized relevance score (0.0-1.0) for accepting a stock clip
MIN_RELEVANCE_THRESHOLD=0.45

# Resilience & Security limits
JOB_EXECUTION_TIMEOUT_SECONDS=1200.0
MEDIA_DOWNLOAD_TOTAL_TIMEOUT_SECONDS=90.0
API_RATE_LIMIT_PER_MINUTE=30

# Media Engine Processing Constraints
MAX_AUDIO_DURATION_SECONDS=600.0
MIN_AUDIO_DURATION_SECONDS=0.5
MIN_SCENE_DURATION_SECONDS=1.8
MAX_SCENE_DURATION_SECONDS=5.0
DEFAULT_FPS=30

# External API Providers (Optional in Phase 1-2 / Mocked in Offline Tests)
PEXELS_API_KEY=
PIXABAY_API_KEY=
STORYBLOCKS_PUBLIC_KEY=
STORYBLOCKS_PRIVATE_KEY=
STORYBLOCKS_ENABLED=false
APISIO_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
